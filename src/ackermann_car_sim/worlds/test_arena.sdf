<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="test_arena">

    <!-- Physics Configuration -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo Sim Plugins -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter Wall (10m x 8m Arena) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 1.0</size></box></geometry><material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 1.0</size></box></geometry><material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 1.0</size></box></geometry><material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 8.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 8.2 1.0</size></box></geometry><material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Room Divider Wall 1 (Creates a doorway) -->
    <model name="divider_wall_1">
      <static>true</static>
      <pose>-1 1.8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.2 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.2 1.0</size></box></geometry><material><ambient>0.7 0.5 0.5 1</ambient><diffuse>0.7 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Room Divider Wall 2 (Creates a corridor) -->
    <model name="divider_wall_2">
      <static>true</static>
      <pose>2 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.8 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.8 1.0</size></box></geometry><material><ambient>0.5 0.7 0.5 1</ambient><diffuse>0.5 0.7 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Central Pillar / Column -->
    <model name="column_1">
      <static>true</static>
      <pose>-3 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry><material><ambient>0.8 0.6 0.2 1</ambient><diffuse>0.8 0.6 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Obstacle Box 1 -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>3.5 2.0 0.3 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.3 0.6 0.8 1</ambient><diffuse>0.3 0.6 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Low Obstacle (RealSense detector test, height 20cm) -->
    <model name="low_obstacle">
      <static>true</static>
      <pose>0.5 -1.0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.4 0.8 0.2</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.4 0.8 0.2</size></box></geometry><material><ambient>0.9 0.3 0.3 1</ambient><diffuse>0.9 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
